# 统一换行，避免 Git Bash 脚本因 CRLF 无法执行
* text=auto

*.sh        text eol=lf
.githooks/* text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# 二进制
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.zip binary
